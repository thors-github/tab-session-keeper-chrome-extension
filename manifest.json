{
  "manifest_version": 3,
  "name": "Tab Session Keeper",
  "version": "1.2.1",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "__MSG_actionTitle__", "default_icon": {"16": "icons/off16.png", "24": "icons/off24.png", "32": "icons/off32.png", "48": "icons/off48.png", "128": "icons/off128.png"}},
  "icons": {"16": "icons/off16.png", "24": "icons/off24.png", "32": "icons/off32.png", "48": "icons/off48.png", "128": "icons/off128.png"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "incognito": "not_allowed",
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
